# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🛡️ CYBER SENTINEL - Environment Template
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Copy this file to .env and fill in your values

APP_NAME=Cyber Sentinel
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
DATABASE_URL=sqlite:///./cyber_sentinel.db
MODEL_PATH=ml/models/ensemble_model.pkl
MODEL_THRESHOLD=0.75
ANOMALY_THRESHOLD=0.85
CAPTURE_INTERFACE=auto
CAPTURE_TIMEOUT=30
MAX_PACKETS_PER_BATCH=100
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
LOG_FILE=logs/cyber_sentinel.log
